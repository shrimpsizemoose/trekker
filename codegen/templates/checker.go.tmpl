func checkKafkaTopicExists(addr, topic string) error {
	logger.Info.Printf("Проверяю наличие топика %s в Kafka...", topic)

	conn, err := kafka.Dial("tcp", addr)
	if err != nil {
		return fmt.Errorf("не удалось подключиться к Kafka: %w", err)
	}
	defer conn.Close()

	partitions, err := conn.ReadPartitions()
	if err != nil {
		return fmt.Errorf("не удалось прочитать партиции: %w", err)
	}

	for _, p := range partitions {
		if p.Topic == topic {
			logger.Victory.Printf("Топик %s найден", topic)
			return nil
		}
	}

	return fmt.Errorf("топик %s не найден в Kafka", topic)
}
