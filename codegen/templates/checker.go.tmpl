func kafkaSendFile(ctx context.Context, addr, topic, filePath string, onStartEvent, onCompleteEvent string) error {
	logger.Info.Printf("Отправляю сообщения из файла %s в топик %s...", filePath, topic)

	if onStartEvent != "" {
		tracker.Ping(onStartEvent, nil)
	}

	file, err := os.Open(filePath)
	if err != nil {
		return fmt.Errorf("не удалось открыть файл %s: %w", filePath, err)
	}
	defer file.Close()

	kafkaConfig := infra.KafkaConfig{
		Addr:  addr,
		Topic: topic,
	}

	writer := infra.NewKafkaWriter(kafkaConfig)
	defer writer.Close()

	var messages [][]byte
	scanner := bufio.NewScanner(file)
	// Increase buffer size for long lines
	buf := make([]byte, 0, 64*1024)
	scanner.Buffer(buf, 1024*1024)

	for scanner.Scan() {
		line := scanner.Bytes()
		if len(line) > 0 {
			// Make a copy since scanner reuses the buffer
			msg := make([]byte, len(line))
			copy(msg, line)
			messages = append(messages, msg)
		}
	}

	if err := scanner.Err(); err != nil {
		return fmt.Errorf("ошибка при чтении файла: %w", err)
	}

	logger.Info.Printf("Прочитано %d сообщений из файла", len(messages))

	if err := writer.WriteMessages(ctx, messages); err != nil {
		return fmt.Errorf("ошибка при отправке сообщений: %w", err)
	}

	logger.Victory.Printf("Отправлено %d сообщений в Kafka", len(messages))

	if onCompleteEvent != "" {
		tracker.Ping(onCompleteEvent, nil)
	}

	return nil
}
