func kafkaRoundtripCheck(ctx context.Context, addr, topic string, messageCount, waitSeconds int, generator string) error {
	logger.Info.Println("----------------------------------------")
	logger.Info.Printf("Начинаю kafka roundtrip тест: %d сообщений", messageCount)

	kafkaConfig := infra.KafkaConfig{
		Addr:  addr,
		Topic: topic,
	}

	writer := infra.NewKafkaWriter(kafkaConfig)
	defer writer.Close()

	// Generate messages
	messages := make([][]byte, messageCount)
	for i := 0; i < messageCount; i++ {
		var msg string
		switch generator {
		case "sequential":
			msg = fmt.Sprintf("msg-%d", i)
		case "timestamp":
			msg = fmt.Sprintf("msg-%d-%d", i, time.Now().UnixNano())
		default: // "uuid" or empty
			msg = fmt.Sprintf("msg-%d-%d", i, time.Now().UnixNano())
		}
		messages[i] = []byte(msg)
	}

	logger.Info.Printf("Отправляю %d сообщений...", messageCount)
	if err := writer.WriteMessages(ctx, messages); err != nil {
		return fmt.Errorf("ошибка при отправке сообщений: %w", err)
	}
	logger.Victory.Printf("Отправлено %d сообщений", messageCount)

	// Wait
	if waitSeconds > 0 {
		logger.Info.Printf("Жду %d секунд...", waitSeconds)
		time.Sleep(time.Duration(waitSeconds) * time.Second)
	}

	// Consume
	logger.Info.Println("Читаю сообщения обратно...")
	reader := infra.NewKafkaReader(kafkaConfig)
	defer reader.Close()

	consumed := 0
	for i := 0; i < messageCount; i++ {
		_, err := reader.ReadMessage(ctx)
		if err != nil {
			return fmt.Errorf("ошибка при чтении сообщения %d: %w", i+1, err)
		}
		consumed++
	}

	logger.Info.Printf("Прочитано %d сообщений", consumed)

	if consumed != messageCount {
		return fmt.Errorf("несовпадение: отправлено %d, получено %d", messageCount, consumed)
	}

	logger.Victory.Printf("Kafka roundtrip успешен: %d/%d сообщений", consumed, messageCount)
	return nil
}
