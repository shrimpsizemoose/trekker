		ContentType:    "{{.ContentType}}",
		{{- end}}
		{{- if .Auth.Type}}
		AuthType:       "{{.Auth.Type}}",
		{{- end}}
		{{- if .Auth.UserEnv}}
		AuthUser:       os.Getenv("{{$.EnvPrefix}}_{{.Auth.UserEnv}}"),
		{{- end}}
		{{- if .Auth.PassEnv}}
		AuthPass:       os.Getenv("{{$.EnvPrefix}}_{{.Auth.PassEnv}}"),
		{{- end}}
		{{- if .Auth.TokenEnv}}
		AuthToken:      os.Getenv("{{$.EnvPrefix}}_{{.Auth.TokenEnv}}"),
		{{- end}}
		ExpectedStatus: {{.ExpectedStatus}},
		{{- if .MessageBefore}}
		MessageBefore:  "{{.MessageBefore}}",
		{{- end}}
		{{- if .MessageSuccess}}
		MessageSuccess: "{{.MessageSuccess}}",
		{{- end}}
		{{- if .HTTPAnalytics.OnRequest}}
		OnRequestEvent: "{{.HTTPAnalytics.OnRequest}}",
		{{- end}}
		{{- if .HTTPAnalytics.OnResponse}}
		OnResponseEvent: "{{.HTTPAnalytics.OnResponse}}",
		{{- end}}
	})
	if err != nil {
		{{- if .OnFailure.Event}}
		tracker.Ping("{{.OnFailure.Event}}", nil)
		{{- end}}
		logger.Error.Fatal(err)
	}
	{{- if .ResponseCheck.JSONField}}
	if err := checkJSONField(respBody, "{{.ResponseCheck.JSONField}}", "{{.ResponseCheck.Expected}}"); err != nil {
		{{- if .OnFailure.Event}}
		tracker.Ping("{{.OnFailure.Event}}", nil)
		{{- end}}
		logger.Error.Fatal(err)
	}
	{{- else}}
	_ = respBody
	{{- end}}
	{{- if .OnSuccess.Event}}
	tracker.Ping("{{.OnSuccess.Event}}", nil)
	{{- end}}
{{- else if eq .Type "wait"}}
	{{- if .WaitAnalytics.OnStart}}
	tracker.Ping("{{.WaitAnalytics.OnStart}}", nil)
	{{- end}}
	{{- if .WaitMessage}}
	logger.Info.Printf("{{.WaitMessage}}")
	{{- else}}
	logger.Info.Printf("Жду %d секунд...", {{.WaitSeconds}})
	{{- end}}
	time.Sleep(time.Duration({{.WaitSeconds}}) * time.Second)
	{{- if .OnSuccess.Event}}
	tracker.Ping("{{.OnSuccess.Event}}", nil)
	{{- end}}
{{- else if eq .Type "kafka_send_file"}}
	if err := kafkaSendFile(rootCtx,
		os.Getenv("{{$.EnvPrefix}}_{{.KafkaAddrEnv}}"),
		os.Getenv("{{$.EnvPrefix}}_{{.KafkaTopicEnv}}"),
		"{{.FilePath}}",
		"{{.KafkaSendFileAnalytics.OnStart}}",
		"{{.KafkaSendFileAnalytics.OnComplete}}",
	); err != nil {
		{{- if .OnFailure.Event}}
		tracker.Ping("{{.OnFailure.Event}}", nil)
		{{- end}}
		logger.Error.Fatal(err)
	}
	{{- if .OnSuccess.Event}}
	tracker.Ping("{{.OnSuccess.Event}}", nil)
	{{- end}}
{{- else if eq .Type "custom"}}
	if err := {{.CustomFunc}}(rootCtx); err != nil {
		{{- if .OnFailure.Event}}
		tracker.Ping("{{.OnFailure.Event}}", nil)
		{{- end}}
		logger.Error.Fatal(err)
	}
	{{- if .OnSuccess.Event}}
	tracker.Ping("{{.OnSuccess.Event}}", nil)
	{{- end}}
{{- else if eq .Type "http_batch"}}
	// HTTP Batch: {{.Name}}
	{
		{{- if .MessageBefore}}
		logger.Info.Println("{{.MessageBefore}}")
		{{- else}}
		logger.Info.Println("Running batch HTTP requests: {{.Name}}")
		{{- end}}

		var testCases []BatchTestCase
		if err := json.Unmarshal({{.HTTPBatch.TestData}}Data, &testCases); err != nil {
			logger.Error.Fatalf("Failed to parse test data: %v", err)
		}

		batchName := "{{.Name}}"
		batchResults[batchName] = make([]BatchResult, 0, len(testCases))
		successCount := 0
		failCount := 0

		for i, tc := range testCases {
			batchCounters.TotalSent++

			reqBody := expandTemplate(`{{.HTTPBatch.RequestTemplate}}`, tc)

			req, err := http.NewRequestWithContext(rootCtx, "{{.Method}}", fmt.Sprintf("{{urlToFormat .URL}}", {{range extractVars .URL}}os.Getenv("{{$.EnvPrefix}}_{{.}}"), {{end}}), bytes.NewBufferString(reqBody))
			if err != nil {
				logger.Error.Printf("[%d] Request creation failed: %v", i, err)
				failCount++
				continue
			}
			{{- if .ContentType}}
			req.Header.Set("Content-Type", "{{.ContentType}}")
			{{- end}}

			resp, err := http.DefaultClient.Do(req)
			if err != nil {
				logger.Error.Printf("[%d] Request failed: %v", i, err)
				failCount++
				continue
			}

			respBody, err := io.ReadAll(resp.Body)
			resp.Body.Close()
			if err != nil {
				logger.Error.Printf("[%d] Failed to read response: %v", i, err)
				failCount++
				continue
			}

			if resp.StatusCode != {{.ExpectedStatus}} {
				logger.Error.Printf("[%d] Expected status {{.ExpectedStatus}}, got %d", i, resp.StatusCode)
				failCount++
				continue
			}

			var respData map[string]interface{}
			if err := json.Unmarshal(respBody, &respData); err != nil {
				logger.Error.Printf("[%d] Failed to parse response JSON: %v", i, err)
				failCount++
				continue
			}

			// Validate response fields
			allFieldsOK := true
			expectedMap := make(map[string]string)
			{{- range .ResponseChecks}}
			{
				actual, found := getJSONField(respData, "{{.JSONField}}")
				if !found {
					logger.Error.Printf("[%d] Field '{{.JSONField}}' not found in response", i)
					allFieldsOK = false
				} else {
					{{- if .FromData}}
					expectedVal := fmt.Sprintf("%v", tc["{{.FromData}}"])
					expectedMap["{{.JSONField}}"] = expectedVal
					if actual != expectedVal {
						logger.Error.Printf("[%d] Field '{{.JSONField}}': expected %q (from {{.FromData}}), got %q", i, expectedVal, actual)
						allFieldsOK = false
					}
					{{- else}}
					expectedMap["{{.JSONField}}"] = "{{.Expected}}"
					if actual != "{{.Expected}}" {
						logger.Error.Printf("[%d] Field '{{.JSONField}}': expected %q, got %q", i, "{{.Expected}}", actual)
						allFieldsOK = false
					}
					{{- end}}
				}
			}
			{{- end}}

			// Store result for potential repeat
			batchResults[batchName] = append(batchResults[batchName], BatchResult{
				Request:  reqBody,
				Expected: expectedMap,
			})

			if allFieldsOK {
				successCount++
				batchCounters.Successful++
			} else {
				failCount++
				batchCounters.Failed++
			}

			{{- if .HTTPBatch.DelayMs}}
			time.Sleep({{.HTTPBatch.DelayMs}} * time.Millisecond)
			{{- end}}
		}

		logger.Info.Printf("Batch '{{.Name}}': %d/%d successful", successCount, len(testCases))
		if failCount > 0 {
			{{- if .OnFailure.Event}}
			tracker.Ping("{{.OnFailure.Event}}", nil)
			{{- end}}
			{{- if .OnFailure.Message}}
			logger.Error.Fatalf("{{.OnFailure.Message}}: %d failures", failCount)
			{{- else}}
			logger.Error.Fatalf("Batch '{{.Name}}' had %d failures", failCount)
			{{- end}}
		}
		{{- if .MessageSuccess}}
		logger.Victory.Println("{{.MessageSuccess}}")
		{{- else}}
		logger.Victory.Printf("Batch '{{.Name}}' completed successfully")
		{{- end}}
		{{- if .OnSuccess.Event}}
		tracker.Ping("{{.OnSuccess.Event}}", nil)
		{{- end}}
	}
{{- else if eq .Type "http_batch_repeat"}}
	// HTTP Batch Repeat: {{.Name}} (reusing {{.ReuseFrom}})
	{
		{{- if .MessageBefore}}
		logger.Info.Println("{{.MessageBefore}}")
		{{- else}}
		logger.Info.Println("Repeating batch requests: {{.Name}}")
		{{- end}}

		previousResults, ok := batchResults["{{.ReuseFrom}}"]
		if !ok || len(previousResults) == 0 {
			logger.Error.Fatalf("No previous results found for batch '{{.ReuseFrom}}'")
		}

		successCount := 0
		failCount := 0

		for i, prev := range previousResults {
			batchCounters.TotalSent++

			req, err := http.NewRequestWithContext(rootCtx, "{{.Method}}", fmt.Sprintf("{{urlToFormat .URL}}", {{range extractVars .URL}}os.Getenv("{{$.EnvPrefix}}_{{.}}"), {{end}}), bytes.NewBufferString(prev.Request))
			if err != nil {
				logger.Error.Printf("[%d] Request creation failed: %v", i, err)
				failCount++
				continue
			}
			{{- if .ContentType}}
			req.Header.Set("Content-Type", "{{.ContentType}}")
			{{- end}}

			resp, err := http.DefaultClient.Do(req)
			if err != nil {
				logger.Error.Printf("[%d] Request failed: %v", i, err)
				failCount++
				continue
			}

			respBody, err := io.ReadAll(resp.Body)
			resp.Body.Close()
			if err != nil {
				logger.Error.Printf("[%d] Failed to read response: %v", i, err)
				failCount++
				continue
			}

			if resp.StatusCode != {{.ExpectedStatus}} {
				logger.Error.Printf("[%d] Expected status {{.ExpectedStatus}}, got %d", i, resp.StatusCode)
				failCount++
				continue
			}

			var respData map[string]interface{}
			if err := json.Unmarshal(respBody, &respData); err != nil {
				logger.Error.Printf("[%d] Failed to parse response JSON: %v", i, err)
				failCount++
				continue
			}

			// Validate response fields
			allFieldsOK := true
			{{- range .ResponseChecks}}
			{
				actual, found := getJSONField(respData, "{{.JSONField}}")
				if !found {
					logger.Error.Printf("[%d] Field '{{.JSONField}}' not found in response", i)
					allFieldsOK = false
				} else {
					{{- if .FromData}}
					expectedVal := prev.Expected["{{.JSONField}}"]
					if actual != expectedVal {
						logger.Error.Printf("[%d] Field '{{.JSONField}}': expected %q, got %q", i, expectedVal, actual)
						allFieldsOK = false
					}
					{{- else}}
					if actual != "{{.Expected}}" {
						logger.Error.Printf("[%d] Field '{{.JSONField}}': expected %q, got %q", i, "{{.Expected}}", actual)
						allFieldsOK = false
					}
					{{- end}}
				}
			}
			{{- end}}

			if allFieldsOK {
				successCount++
				batchCounters.CacheHits++
			} else {
				failCount++
			}

			{{- if .HTTPBatch.DelayMs}}
			time.Sleep({{.HTTPBatch.DelayMs}} * time.Millisecond)
			{{- end}}
		}

		logger.Info.Printf("Batch repeat '{{.Name}}': %d/%d successful", successCount, len(previousResults))
		if failCount > 0 {
			{{- if .OnFailure.Event}}
			tracker.Ping("{{.OnFailure.Event}}", nil)
			{{- end}}
			{{- if .OnFailure.Message}}
			logger.Error.Fatalf("{{.OnFailure.Message}}: %d failures", failCount)
			{{- else}}
			logger.Error.Fatalf("Batch repeat '{{.Name}}' had %d failures", failCount)
			{{- end}}
		}
		{{- if .MessageSuccess}}
		logger.Victory.Println("{{.MessageSuccess}}")
		{{- else}}
		logger.Victory.Printf("Batch repeat '{{.Name}}' completed successfully")
		{{- end}}
		{{- if .OnSuccess.Event}}
		tracker.Ping("{{.OnSuccess.Event}}", nil)
		{{- end}}
	}
{{- end}}
{{- if .SkipOnFlag}}
	}
{{- end}}
{{end}}

	logger.Info.Println("----------------------------------------")
	logger.Victory.Println("{{.SuccessMessage}}")

	tracker.PingFinish()
}
