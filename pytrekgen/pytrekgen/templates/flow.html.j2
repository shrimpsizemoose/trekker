<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lab {{ config.lab.id }}: {{ config.lab.name }}</title>
<style>
  :root {
    --bg: #f8f9fa; --fg: #212529; --card: #fff; --border: #dee2e6;
    --accent: #0d6efd; --success: #198754; --danger: #dc3545;
    --muted: #6c757d; --sidebar-bg: #f1f3f5;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: system-ui, -apple-system, sans-serif; background: var(--bg); color: var(--fg); line-height: 1.5; }
  .header { background: var(--accent); color: #fff; padding: 1.5rem 2rem; }
  .header h1 { font-size: 1.5rem; font-weight: 600; }
  .header .meta { opacity: 0.85; font-size: 0.9rem; margin-top: 0.25rem; }
  .layout { display: flex; gap: 1.5rem; padding: 1.5rem 2rem; max-width: 1400px; margin: 0 auto; }
  .main { flex: 1; min-width: 0; }
  .sidebar { width: 320px; flex-shrink: 0; }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; margin-bottom: 1rem; }
  .card h3 { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 0.75rem; }
  .card ul { list-style: none; padding: 0; }
  .card li { padding: 0.2rem 0; font-size: 0.9rem; }
  .card li code { background: var(--sidebar-bg); padding: 0.1rem 0.35rem; border-radius: 3px; font-size: 0.85rem; }
  .mermaid-wrap { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem; overflow-x: auto; }
  .mermaid-wrap .nodeLabel { text-align: left; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 2px solid var(--border); font-weight: 600; white-space: nowrap; }
  td { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  tr:hover td { background: var(--sidebar-bg); }
  .tag { display: inline-block; padding: 0.1rem 0.5rem; border-radius: 3px; font-size: 0.8rem; font-weight: 500; }
  .tag-success { background: #d1e7dd; color: var(--success); }
  .tag-fail { background: #f8d7da; color: var(--danger); }
  .tag-skip { background: #fff3cd; color: #664d03; }
  .event { font-family: monospace; font-size: 0.82rem; }
  .event-row td { border-bottom: 2px solid var(--border); padding-top: 0; }
  .event-row + tr td, tr:has(+ .event-row) td { border-bottom: none; }
  .event-cell { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  @media (max-width: 900px) {
    .layout { flex-direction: column; }
    .sidebar { width: 100%; }
  }
</style>
</head>
<body>

<div class="header">
  <h1>Lab {{ config.lab.id }}: {{ config.lab.name }}</h1>
  <div class="meta">
    {%- if config.lab.env_prefix %}Prefix: <strong>{{ config.lab.env_prefix }}</strong> | {% endif %}
    {{ config.checks | length }} check{{ "s" if config.checks | length != 1 }} |
    Generated by pytrekgen
  </div>
</div>

<div class="layout">
  <div class="main">
    <div class="mermaid-wrap">
      <pre class="mermaid">
{{ mermaid_text }}
      </pre>
    </div>

    <div class="card">
      <h3>Check Details</h3>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Type</th>
            <th>Name</th>
            <th>Details</th>
          </tr>
        </thead>
        <tbody>
          {%- for check in config.checks %}
          <tr id="check-{{ loop.index }}">
            <td>{{ loop.index }}</td>
            <td><code>{{ check | check_type_label(config) }}</code></td>
            <td><strong>{{ check.name or "—" }}</strong></td>
            <td>{{ check | check_detail(config) }}</td>
          </tr>
          {%- set has_events = (check.on_success and check.on_success.event) or (check.on_failure and check.on_failure.event) or check.skip_on_flag %}
          {%- if has_events %}
          <tr class="event-row">
            <td></td>
            <td colspan="3" class="event-cell">
              {%- if check.on_success and check.on_success.event %}
              <span class="tag tag-success event">&#10003; {{ check.on_success.event }}</span>
              {%- endif %}
              {%- if check.on_failure and check.on_failure.event %}
              <span class="tag tag-fail event">&#10007; {{ check.on_failure.event }}</span>
              {%- endif %}
              {%- if check.skip_on_flag %}
              <span class="tag tag-skip">skip: --{{ check.skip_on_flag }}</span>
              {%- endif %}
            </td>
          </tr>
          {%- endif %}
          {%- endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <div class="sidebar">
    {%- if config.required_env %}
    <div class="card">
      <h3>Required Environment Variables</h3>
      <ul>
        {%- for env in config.required_env %}
        <li><code>{{ env.name | prefixed_env(config.lab.env_prefix) }}</code></li>
        {%- endfor %}
      </ul>
    </div>
    {%- endif %}

    {%- if config.optional_env or config.optional_env_int %}
    <div class="card">
      <h3>Optional Environment Variables</h3>
      <ul>
        {%- for env in config.optional_env %}
        <li><code>{{ env.name | prefixed_env(config.lab.env_prefix) }}</code> <span style="color:var(--muted)">(default: {{ env.default }})</span></li>
        {%- endfor %}
        {%- for env in config.optional_env_int %}
        <li><code>{{ env.name | prefixed_env(config.lab.env_prefix) }}</code> <span style="color:var(--muted)">(default: {{ env.default }})</span></li>
        {%- endfor %}
      </ul>
    </div>
    {%- endif %}

    <div class="card">
      <h3>Analytics</h3>
      <ul>
        <li>Endpoint: <code>{{ config.analytics.url_env }}</code></li>
        {%- if config.analytics.skip_tls %}
        <li>TLS verification: <strong>skipped</strong></li>
        {%- endif %}
        {%- if config.analytics.offline %}
        <li>Mode: <strong>offline</strong></li>
        {%- endif %}
        {%- for k, v in config.analytics.headers.items() %}
        <li><code>{{ k }}</code>: {{ v }}</li>
        {%- endfor %}
      </ul>
    </div>

    <div class="card">
      <h3>Built-in Flags</h3>
      <ul>
        <li><code>--ping</code></li>
        <li><code>--version</code></li>
        <li><code>--checks</code></li>
        {%- for f in config.flags %}
        <li><code>--{{ f.name }}</code>{% if f.description %} — {{ f.description }}{% endif %}</li>
        {%- endfor %}
      </ul>
    </div>

    {%- if config.success_message %}
    <div class="card">
      <h3>Success Message</h3>
      <p style="font-size:0.9rem;">{{ config.success_message }}</p>
    </div>
    {%- endif %}
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
<script>mermaid.initialize({ startOnLoad: true, theme: 'default' });</script>
</body>
</html>
