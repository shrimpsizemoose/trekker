
func kafkaCompare(
	ctx context.Context,
	kafkaAddr string,
	sendTopic string,
	sendData []byte,
	receiveTopic string,
	expectedData []byte,
	waitBefore time.Duration,
	timeout time.Duration,
	matchBy []string,
	compareFields []string,
	floatTolerance float64,
	runID string,
) error {
	// Parse expected into map[key]map[string]interface{}
	expectedMap := make(map[string]map[string]interface{})
	scanner := bufio.NewScanner(bytes.NewReader(expectedData))
	for scanner.Scan() {
		line := scanner.Bytes()
		if len(line) == 0 {
			continue
		}
		var msg map[string]interface{}
		if err := json.Unmarshal(line, &msg); err != nil {
			return fmt.Errorf("ошибка парсинга expected JSONL: %w", err)
		}
		key := kafkaCompareBuildKey(msg, matchBy)
		expectedMap[key] = msg
	}

	logger.Info.Printf("Ожидаю %d окон с run_id=%s", len(expectedMap), runID)

	// Inject run_id into each input message before sending
	var messages [][]byte
	scanner = bufio.NewScanner(bytes.NewReader(sendData))
	for scanner.Scan() {
		line := scanner.Bytes()
		if len(line) == 0 {
			continue
		}
		var msg map[string]interface{}
		if err := json.Unmarshal(line, &msg); err != nil {
			return fmt.Errorf("ошибка парсинга input JSONL: %w", err)
		}
		msg["run_id"] = runID
		enriched, err := json.Marshal(msg)
		if err != nil {
			return fmt.Errorf("ошибка сериализации: %w", err)
		}
		messages = append(messages, enriched)
	}

	// Send input data to send topic
	writer := infra.NewKafkaWriter(infra.KafkaConfig{
		Addr:  kafkaAddr,
		Topic: sendTopic,
	})
	defer writer.Close()

	if err := writer.WriteMessages(ctx, messages); err != nil {
		return fmt.Errorf("не удалось отправить данные в Kafka: %w", err)
	}
	logger.Info.Printf("Отправлено %d сообщений в %s (run_id=%s)", len(messages), sendTopic, runID)

	// Wait before reading
	if waitBefore > 0 {
		logger.Info.Printf("Жду %s перед чтением...", waitBefore)
		time.Sleep(waitBefore)
	}

	// Read from output topic
	reader := infra.NewKafkaReader(infra.KafkaConfig{
		Addr:  kafkaAddr,
		Topic: receiveTopic,
	})
	defer reader.Close()

	// Collect last value per key, filtering by run_id
	receivedMap := make(map[string]map[string]interface{})
	deadline := time.Now().Add(timeout)
	lastMsg := time.Now()

	for time.Now().Before(deadline) {
		readCtx, cancel := context.WithTimeout(ctx, 5*time.Second)
		msg, err := reader.ReadMessage(readCtx)
		cancel()

		if err != nil {
			if len(receivedMap) >= len(expectedMap) && time.Since(lastMsg) > 10*time.Second {
				break
			}
			continue
		}

		var received map[string]interface{}
		if err := json.Unmarshal(msg, &received); err != nil {
			continue
		}

		// Skip messages from other runs
		if rid, ok := received["run_id"]; !ok || fmt.Sprintf("%v", rid) != runID {
			continue
		}

		lastMsg = time.Now()
		key := kafkaCompareBuildKey(received, matchBy)
		if _, ok := expectedMap[key]; ok {
			receivedMap[key] = received
		}
	}

	// Check missing
	var missing []string
	for key := range expectedMap {
		if _, ok := receivedMap[key]; !ok {
			missing = append(missing, key)
		}
	}
	if len(missing) > 0 {
		limit := len(missing)
		if limit > 5 {
			limit = 5
		}
		return fmt.Errorf(
			"не получил %d из %d ожидаемых сообщений (таймаут %s, run_id=%s). Отсутствуют: %v",
			len(missing), len(expectedMap), timeout, runID, missing[:limit],
		)
	}

	// Compare last received value per key
	for key, expected := range expectedMap {
		received := receivedMap[key]
		for _, field := range compareFields {
			expVal := kafkaCompareToFloat(expected[field])
			gotVal := kafkaCompareToFloat(received[field])
			if math.Abs(expVal-gotVal) > floatTolerance {
				return fmt.Errorf(
					"сообщение %s: поле %s — ожидал %s, получил %s (run_id=%s)",
					key, field, kafkaFmtNum(expVal), kafkaFmtNum(gotVal), runID,
				)
			}
		}
	}

	return nil
}

func kafkaCompareBuildKey(msg map[string]interface{}, fields []string) string {
	parts := make([]string, len(fields))
	for i, f := range fields {
		switch val := msg[f].(type) {
		case float64:
			if val == math.Trunc(val) {
				parts[i] = fmt.Sprintf("%.0f", val)
			} else {
				parts[i] = fmt.Sprintf("%g", val)
			}
		default:
			parts[i] = fmt.Sprintf("%v", val)
		}
	}
	return strings.Join(parts, "_")
}

func kafkaFmtNum(v float64) string {
	if v == math.Trunc(v) && math.Abs(v) < 1e15 {
		return fmt.Sprintf("%.0f", v)
	}
	return fmt.Sprintf("%.4f", v)
}

func kafkaCompareToFloat(v interface{}) float64 {
	switch val := v.(type) {
	case float64:
		return val
	case int:
		return float64(val)
	case json.Number:
		f, _ := val.Float64()
		return f
	default:
		return 0
	}
}
