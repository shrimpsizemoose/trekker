	{
		// clickhouse_compare: {{ check.name }}
{% if check.message_before %}
		logger.Info.Println({{ check.message_before | go_string }})
{% endif %}
		err := func() error {
{% if check.expected_file_env %}
			path := os.Getenv({{ check.expected_file_env | prefixed_env(config.env_prefix) | go_string }})
			if path == "" {
				return fmt.Errorf("expected file path is empty")
			}
			file, err := os.Open(path)
			if err != nil {
				return err
			}
			defer file.Close()
			expected, err := ccRead(file)
			if err != nil {
				return err
			}
{% else %}
			expected := {{ config.get_embedded_var_by_file(check.expected_file_jsonl) }}
{% endif %}
			var missingParam string
			opts := ccOptions{
				Addr: os.Getenv({{ check.clickhouse_addr_env | prefixed_env(config.env_prefix) | go_string }}),
{% if check.clickhouse_user_env %}
				User: os.Getenv({{ check.clickhouse_user_env | prefixed_env(config.env_prefix) | go_string }}),
{% endif %}
{% if check.clickhouse_pass_env %}
				Pass: os.Getenv({{ check.clickhouse_pass_env | prefixed_env(config.env_prefix) | go_string }}),
{% endif %}
				Query: {{ check.query | go_string }},
				Params: map[string]string{
{% for name, value in check.params.items() %}
					{{ name | go_string }}: ccEnvPattern.ReplaceAllStringFunc({{ value | go_string }}, func(match string) string {
						name := match[2:len(match)-1]
{% if config.env_prefix %}
						if !strings.HasPrefix(name, {{ (config.env_prefix + '_') | go_string }}) {
							name = {{ (config.env_prefix + '_') | go_string }} + name
						}
{% endif %}
						value, ok := os.LookupEnv(name)
						if !ok {
							missingParam = name
						}
						return value
					}),
{% endfor %}
				},
				Columns: map[string]string{
{% for name, kind in check.columns.items() %}
					{{ name | go_string }}: {{ kind | go_string }},
{% endfor %}
				},
				MatchBy: []string{ {{ check.match_by | map('go_string') | join(', ') }} },
				Timeout: {{ check.timeout_seconds }} * time.Second,
				RequestTimeout: {{ check.request_timeout_seconds }} * time.Second,
				PollInterval: {{ check.poll_interval_ms }} * time.Millisecond,
			}
			if missingParam != "" {
				return fmt.Errorf("query parameter environment variable %s is not set", missingParam)
			}
			return clickhouseCompare(rootCtx, opts, expected)
		}()
		if err != nil {
{% if check.on_failure.event %}
			tracker.Ping({{ check.on_failure.event | go_string }}, nil)
{% endif %}
{% if check.on_failure.message %}
			logger.Error.Fatalf("%s: %v", {{ check.on_failure.message | go_string }}, err)
{% else %}
			logger.Error.Fatal(err)
{% endif %}
		}
{% if check.message_success %}
		logger.Victory.Println({{ check.message_success | go_string }})
{% endif %}
{% if check.on_success.event %}
		tracker.Ping({{ check.on_success.event | go_string }}, nil)
{% endif %}
	}
