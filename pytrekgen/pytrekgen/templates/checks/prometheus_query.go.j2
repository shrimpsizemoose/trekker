	{
{% if check.message_before %}
		logger.Info.Println({{ check.message_before | go_string }})
{% endif %}
		err := prometheusWait(rootCtx, {{ check.url | url_format(config.env_prefix) }}, {{ check.timeout_seconds }} * time.Second,
			{{ check.query | go_string }}, {{ check.operator | go_string }}, {{ check.expected }}, "", "")
		if err != nil {
{% if check.on_failure.event %}
			tracker.Ping({{ check.on_failure.event | go_string }}, nil)
{% endif %}
{% if check.on_failure.message %}
			logger.Error.Fatalf("%s: %v", {{ check.on_failure.message | go_string }}, err)
{% else %}
			logger.Error.Fatal(err)
{% endif %}
		}
{% if check.message_success %}
		logger.Victory.Println({{ check.message_success | go_string }})
{% endif %}
{% if check.on_success.event %}
		tracker.Ping({{ check.on_success.event | go_string }}, nil)
{% endif %}
	}
