	if err := checkKafkaTopicExists(
		os.Getenv("{{ check.kafka_addr_env | prefixed_env(config.env_prefix) }}"),
		os.Getenv("{{ check.kafka_topic_env | prefixed_env(config.env_prefix) }}"),
		"{{ check.on_connect }}",
		"{{ check.on_partitions_read }}",
	); err != nil {
		logger.Error.Fatal(err)
	}
{% if check.on_success.event %}
	tracker.Ping("{{ check.on_success.event }}", nil)
{% endif %}
